# URL base de la API REST del backend
# En desarrollo local: http://localhost:8080/api
# En producción (Render): https://exportrace-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# URL base pública para el sistema y códigos QR de trazabilidad
# En desarrollo local en tu misma máquina: http://localhost:5173
# En desarrollo para escanear con móvil en la misma red Wi-Fi: http://192.168.X.X:5173
# En producción (Render/Vercel): https://exportrace-frontend.onrender.com
VITE_PUBLIC_APP_URL=http://localhost:5173
